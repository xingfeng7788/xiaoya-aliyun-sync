ALIST_URL=http://192.168.0.201:5678
ADMIN_TOKEN=your_alist_token
DEST_PATH=/我的网盘/来自小雅
INDEX_FILE_PATH=/etc/xiaoya/index.txt
HOST=0.0.0.0
PORT=5000

# --- 阿里云盘 Open API 配置 (用于高级转存) ---
# 申请地址: https://alist.nn.ci/zh/guide/drivers/aliyundrive_open.html (或使用现有 Token)
ALI_OPEN_TOKEN=your_aliyun_open_token_here
ALI_DRIVE_ID=your_drive_id_here
ALI_resource_drive_id=your_resource_drive_id_here
# 目标文件夹 ID (你希望转存到哪个文件夹下)
ALI_TARGET_FOLDER_ID=root
