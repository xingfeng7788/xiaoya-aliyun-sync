# ==================== 小雅资源助手配置 ====================

# --- 必填项 ---
# 小雅 Alist 搜索地址
XIAOYA_URL=http://127.0.0.1:5678
# Alist 管理员 Token（用于读取存储挂载信息）
ADMIN_TOKEN=

# --- 服务配置 ---
HOST=0.0.0.0
PORT=5666
# Flask Session 密钥（留空则每次启动随机生成，建议固定）
SECRET_KEY=

# --- Alist 地址 ---
ALIST_URL=http://127.0.0.1:5234

# --- 阿里云盘（可通过页面扫码登录，无需手动填写） ---
ALI_REFRESH_TOKEN=

# --- PushPlus 微信通知（Token 失效时自动推送） ---
# 从 https://www.pushplus.plus 获取 Token
PUSHPLUS_TOKEN=
# 群组编码（可选，一对多推送时使用）
PUSHPLUS_TOPIC=

# --- 外部访问地址（用于通知中的链接） ---
# 如 http://your-ip:5666
XIAOYA_EXTERNAL_URL=